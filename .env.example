# Copy to .env and adjust. Never commit real secrets.

# --- Shared ---
NODE_ENV=development

# --- API (apps/api) ---
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://inbetween:inbetween@localhost:5432/inbetween?schema=public
REDIS_URL=redis://localhost:6379

# Auth (generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Object storage (SeaweedFS locally, S3/R2 in production)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev
S3_BUCKET_PUBLIC=inbetween-public
S3_BUCKET_PRIVATE=inbetween-private

# Email (Mailpit locally)
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="inBetween <no-reply@inbetween.local>"

# Payments (Paymob test mode). Get keys from the Paymob dashboard.
PAYMOB_API_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_INTEGRATION_ID_WALLET=

# Fees in basis points (1000 = 10%)
RENTER_SERVICE_FEE_BPS=1000
OWNER_COMMISSION_BPS=1000

# SMS / KYC providers (to be selected in M1/M3)
SMS_PROVIDER=console
KYC_PROVIDER=manual

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_DEFAULT_LOCALE=ar
