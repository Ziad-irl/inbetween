{
  "name": "inbetween",
  "private": true,
  "description": "inBetween: rent anything, from a needle to a rocket.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @inbetween/api db:generate",
    "db:migrate": "pnpm --filter @inbetween/api db:migrate",
    "db:seed": "pnpm --filter @inbetween/api db:seed",
    "db:studio": "pnpm --filter @inbetween/api db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
